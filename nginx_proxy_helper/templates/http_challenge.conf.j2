# ============================================================
# HTTP Challenge Configuration (Temporary ACME Validation)
# Domain: {{ domain }}
# Generated by nginx-proxy-helper
# ============================================================

server {
    listen 80;
    listen [::]:80;
    server_name {{ domain }}{% if www %} www.{{ domain }}{% endif %};

    # Let's Encrypt ACME challenge location
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Return 200 OK for verification
    location / {
        default_type text/plain;
        return 200 "nginx-proxy-helper: waiting for SSL certificate verification...\n";
    }
}
