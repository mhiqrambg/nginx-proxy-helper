# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environment
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Certbot data (generated at runtime)
nginx-alpine/certbot/conf/*
nginx-alpine/certbot/www/*
!nginx-alpine/certbot/conf/.gitkeep
!nginx-alpine/certbot/www/.gitkeep

# Generated nginx configs (managed by CLI)
nginx-alpine/nginx/conf.d/*.conf
!nginx-alpine/nginx/conf.d/00-default.conf

# Generated dummy SSL certs
nginx-alpine/nginx/ssl/*
!nginx-alpine/nginx/ssl/.gitkeep

# Backups (generated by rollback system)
nginx-alpine/.backups/
